# Endereço do backend para onde o proxy do Vite encaminha os pedidos a /api em desenvolvimento.
# Por omissão, http://localhost:5041.
BACKEND_URL=http://localhost:5041

# URL base da API do backend (secção 4.1 da Documentação da API).
# Por omissão, /api no mesmo servidor: em desenvolvimento, o proxy do Vite encaminha para o backend.
# Exemplo para um backend noutro endereço: VITE_API_BASE_URL=http://192.168.1.10:5041/api
VITE_API_BASE_URL=/api
